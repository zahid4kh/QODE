#!/bin/bash
# prerm: runs before the files of @PACKAGE@ are removed.
set -e

PKG="@PACKAGE@"
VERSION="@VERSION@"
SWITCH=/run/qode-package-switch # read by postrm (keep the user data) and by the new package's postinst

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$'\e[1m' D=$'\e[2m' A=$'\e[38;5;75m' Y=$'\e[33m' N=$'\e[0m'
else
    B='' D='' A='' Y='' N=''
fi
say() { echo "  ${A}│${N}${1:+ $1}" >&2; }

case "$1" in
    remove)
        # Replaced by another QODE package (qode <-> qode-bundled <-> qode-bundled-noweb): only the binary changes,
        # so running windows and the user data stay.
        if [ "${2:-}" = "in-favour" ] && [[ "${3:-}" =~ ^qode(-bundled|-bundled-noweb)?$ ]]; then
            echo "$PKG $VERSION" > "$SWITCH"
            exit 0
        fi
        rm -f "$SWITCH"

        echo >&2
        echo "  ${A}╭─${N} ${B}Removing QODE $VERSION${N} ${D}($PKG)${N} ${A}─────────────────────────────${N}" >&2
        # The data folders are deleted afterwards (see postrm), so a running editor must not write into them.
        if pgrep -x qode >/dev/null 2>&1; then
            say "${Y}!${N} closing running QODE windows (save your work first next time)"
            pkill -x qode || true
            sleep 1
        fi

        # Our convenience link (only if it really is ours).
        if [ -L /usr/local/bin/qode ] && [ "$(readlink /usr/local/bin/qode)" = "/usr/bin/qode" ]; then
            rm -f /usr/local/bin/qode
        fi

        if [ "${QODE_KEEP_USER_DATA:-}" = "1" ]; then
            say "QODE_KEEP_USER_DATA=1: settings, projects and downloaded servers are kept"
        else
            say "This also deletes, for every user:"
            say "  ${D}~/.config/QODE-AGENTIC${N}       settings and per-project data"
            say "  ${D}~/.local/share/QODE-AGENTIC${N}  downloaded language servers, local history"
            say "  ${D}~/.cache/QODE-AGENTIC${N}        caches"
            say "${D}To keep them: sudo QODE_KEEP_USER_DATA=1 apt remove $PKG${N}"
        fi
        if command -v clangd >/dev/null 2>&1; then
            say "clangd is installed system-wide; QODE leaves it alone ('qode-remove-lsp --cpp' removes it)."
        fi
        echo "  ${A}╰──────────────────────────────────────────────────────────${N}" >&2
        ;;

    deconfigure)
        ;;

    upgrade)
        # A new version replaces the files in place; running windows and user data are left alone.
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
